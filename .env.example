# Copy to .env. These values are local-only placeholders; never add real secrets here.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docpipeline
DB_USERNAME=docpipeline
DB_PASSWORD=docpipeline

# Reserved for cache/idempotency integration
REDIS_HOST=localhost
REDIS_PORT=6379

# LocalStack / AWS
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=ap-south-1
S3_BUCKET_NAME=docpipeline-documents
KMS_KEY_ID=alias/docpipeline-key
SQS_QUEUE_NAME=docpipeline-s3-events

# Local development only. Generate a unique value with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_A_UNIQUE_BASE64_ENCODED_256_BIT_SECRET

VITE_API_BASE_URL=http://localhost:8080/api
